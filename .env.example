# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Async SQLAlchemy URL (SQLite is the zero-config default).
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///cryptobot.db

# Platform fee taken from each completed trade (0.01 = 1%).
FEE_RATE=0.01

# How long (seconds) to cache market rates from CoinGecko.
RATE_TTL_SECONDS=60
